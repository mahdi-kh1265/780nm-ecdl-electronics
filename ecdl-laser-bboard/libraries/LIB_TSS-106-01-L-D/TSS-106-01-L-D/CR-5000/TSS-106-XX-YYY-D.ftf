                        (r 5000)
                        (begin
                          (pt -185000 5000
                            (width 20000)
                          )
                        )
                        (center 0 0)
                        (end
                          (pt -185000 5000
                            (width 20000)
                          )
                        )
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer CompArea-Top)
