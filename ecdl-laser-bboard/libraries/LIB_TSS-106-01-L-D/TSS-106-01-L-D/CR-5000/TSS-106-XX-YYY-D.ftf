                      (pt -127000 -336500
                        (width 10000)
                      )
                      (pt -127000 590500
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
              (line
                (geometry
                  (line
                    (vertex
