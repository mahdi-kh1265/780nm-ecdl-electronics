                (geometry
                  (line
                    (vertex
                      (pt -127000 590500
                        (width 10000)
                      )
                      (pt 1397000 590500
                        (width 10000)
                      )
                    )
                  )
                )
              )
            )
            (layer (footLayer Silk-Top)
