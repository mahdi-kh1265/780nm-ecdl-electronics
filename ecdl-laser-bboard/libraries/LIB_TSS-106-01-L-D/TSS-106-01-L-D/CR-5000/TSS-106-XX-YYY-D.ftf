                    (fillWidth 0)
                    (fillAngle 0.000000)
                    (vertex
                    (pt 1517000 710500)
                    (pt 1517000 -456500)
                    (pt -295000 -456500)
                    (pt -295000 710500)
                    )
                  )
                )
              )
            )
           ); End of layout
